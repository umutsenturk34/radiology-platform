# Backend environment template — docs/DEPLOYMENT_PILOT.md sections 23, 24 and 29.
# Never commit real secrets. Copy to .env (git-ignored) for local development.
#
# Railway deployment (DEVOPS-001): the same variables are set on the `backend`
# service. There DATABASE_URL and REDIS_URL are Railway references
# (${{Postgres.DATABASE_URL}} / ${{Redis.REDIS_URL}}), which resolve to the
# private network — no TCP proxy, no sslmode juggling, sub-millisecond round
# trips — so the pool and transaction tuning below is only needed locally.

# --- runtime ---
NODE_ENV=development
APP_ENV=local
PORT=3001
LOG_LEVEL=info

# --- infrastructure ---
# PostgreSQL. Reaching Railway from a developer machine goes through a TCP
# proxy, which makes `sslmode=require` mandatory and connection setup slow. Pin
# the Prisma pool explicitly, otherwise the default pool (cpus * 2 + 1) cannot
# be filled inside the default 10s pool timeout and startup fails with P2024:
#   ?sslmode=require&connect_timeout=30&connection_limit=5&pool_timeout=30
DATABASE_URL=
REDIS_URL=

# Interactive transaction limits. Prisma's 5s default is not enough over a TCP
# proxy: a workflow transition writes the study, its status history and its
# audit row, and each round trip can cost about a second. Finalization is the
# heaviest transaction (report version, two transitions, delivery row and
# audit entries — roughly fifteen statements), so a developer machine reaching
# Railway through the proxy needs 45000 here. Railway-internal deployment,
# where a round trip is sub-millisecond, can use the default.
DATABASE_TRANSACTION_TIMEOUT_MS=15000
DATABASE_TRANSACTION_MAX_WAIT_MS=10000

# --- auth ---
# Generate with: openssl rand -base64 48
# Minimum 32 characters, and the two values MUST differ so a leak of one does
# not compromise the other. Both are REQUIRED in production; outside production
# a random per-process secret is generated (tokens then die on restart).
JWT_SECRET=
JWT_REFRESH_SECRET=
# Duration format: 900s / 15m / 2h / 7d.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- seed (TASK_QUEUE BACKEND-005) ---
# Password given to the four seeded pilot test accounts
# (doctor/reporter/operation/manager @test.local).
# Optional for local development — the seed falls back to a documented dev
# password. REQUIRED when NODE_ENV=production: the seed refuses to run without
# it so a known default password never reaches a production database.
# Re-running the seed does NOT reset an existing user's password.
SEED_DEFAULT_PASSWORD=

# Opt-in credential rotation. Off by default so re-seeding never silently
# invalidates credentials in use. Set to true for the one run that rotates the
# seeded accounts onto a new SEED_DEFAULT_PASSWORD — needed once an environment
# becomes reachable from the internet, since the development fallback password
# is published in this repository.
SEED_FORCE_PASSWORD_RESET=false

# --- cors ---
# Comma separated list of allowed browser origins. No wildcard for an
# authenticated API (API_CONTRACT.md section 7).
FRONTEND_URL=http://localhost:3000

# --- pilot feature flags ---
DEV_TOOLS_ENABLED=false
ALLOW_MOCK_INTEGRATIONS=false

# --- object storage (audio dictations) ---
# Driver: local | s3
# The pilot ships with `local`, which writes under OBJECT_STORAGE_LOCAL_DIR.
# Those files do NOT survive a container rebuild, so a deployed pilot needs a
# real bucket (DEVOPS-004). Selecting `s3` before that adapter exists fails at
# startup rather than silently writing to disk.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=.storage

# Lifetime of a dictation playback URL, and the largest upload accepted.
PLAYBACK_URL_TTL_SECONDS=300
MAX_DICTATION_UPLOAD_BYTES=52428800

# Required once the s3 driver lands.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

# --- locking (defaults from TASK_QUEUE BACKEND-015) ---
LOCK_TTL_SECONDS=60
LOCK_HEARTBEAT_SECONDS=20
