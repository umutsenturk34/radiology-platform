# Backend environment template — docs/DEPLOYMENT_PILOT.md sections 23, 24 and 29.
# Never commit real secrets. Copy to .env (git-ignored) for local development.

# --- runtime ---
NODE_ENV=development
APP_ENV=local
PORT=3001
LOG_LEVEL=info

# --- infrastructure ---
# Required once BACKEND-002 (Prisma) and BACKEND-003 (Redis) land.
DATABASE_URL=
REDIS_URL=

# --- auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- seed (TASK_QUEUE BACKEND-005) ---
# Password given to the four seeded pilot test accounts
# (doctor/reporter/operation/manager @test.local).
# Optional for local development — the seed falls back to a documented dev
# password. REQUIRED when NODE_ENV=production: the seed refuses to run without
# it so a known default password never reaches a production database.
# Re-running the seed does NOT reset an existing user's password.
SEED_DEFAULT_PASSWORD=

# --- cors ---
# Comma separated list of allowed browser origins. No wildcard for an
# authenticated API (API_CONTRACT.md section 7).
FRONTEND_URL=http://localhost:3000

# --- pilot feature flags ---
DEV_TOOLS_ENABLED=false
ALLOW_MOCK_INTEGRATIONS=false

# --- object storage (audio dictations) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=

# --- locking (defaults from TASK_QUEUE BACKEND-015) ---
LOCK_TTL_SECONDS=60
LOCK_HEARTBEAT_SECONDS=20
