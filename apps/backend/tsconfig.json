{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2023",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    // Must live inside outDir: `nest build` deletes dist/, and a build-info
    // file surviving outside it makes TypeScript skip emitting unchanged
    // files, producing a silently incomplete dist/.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "isolatedModules": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "jest"],
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
